<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_panel_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/surfaceColorGlass"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <!-- CABECERA FIJA CON GRADIENTE -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_alignParentTop="true"
            android:background="@drawable/header_gradient"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <!-- Botón cerrar -->
            <ImageButton
                android:id="@+id/btn_close_panel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@android:color/white"
                android:contentDescription="@string/content_desc_close"
                android:scaleType="centerInside" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Botón favorito en cabecera -->
            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_star_outline"
                android:contentDescription="@string/content_desc_favorite"
                app:tint="@android:color/white"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- CONTENIDO DESPLAZABLE -->
        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/header"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- INFORMACIÓN PRINCIPAL (sin tarjeta anidada) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_station_name"
                        style="@style/TextAppearance.GeoGas.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/details_gas_station_name" />

                    <TextView
                        android:id="@+id/tv_station_address"
                        style="@style/TextAppearance.GeoGas.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/details_gas_station_address" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_location"
                            android:importantForAccessibility="no"
                            app:tint="@color/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_location"
                            style="@style/TextAppearance.GeoGas.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/details_gas_station_location" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/horario_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_clock"
                            android:importantForAccessibility="no"
                            app:tint="@color/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_horario"
                            style="@style/TextAppearance.GeoGas.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/details_schedule" />

                    </LinearLayout>

                </LinearLayout>

                <!-- HÉROE: PRECIO DESTACADO CON BADGE SEMÁNTICO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_rounded"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.GeoGas.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/details_featured_price"
                            android:textColor="@color/textColorSecondary" />

                        <TextView
                            android:id="@+id/tv_main_price"
                            style="@style/TextAppearance.GeoGas.Price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/price_placeholder" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_price_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/price_class_medium"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- SECCIÓN: GASOLINA -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/neutral_200" />

                <TextView
                    style="@style/TextAppearance.GeoGas.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/details_gasoline_prices"
                    android:textColor="@color/textColorAccent" />

                <TableLayout
                    android:id="@+id/table_gasolina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:stretchColumns="1" />

                <!-- SECCIÓN: DIÉSEL -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/neutral_200" />

                <TextView
                    style="@style/TextAppearance.GeoGas.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/details_diesel_prices"
                    android:textColor="@color/textColorAccent" />

                <TableLayout
                    android:id="@+id/table_diesel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:stretchColumns="1" />

                <!-- SECCIÓN: COMBUSTIBLES ALTERNATIVOS -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/neutral_200" />

                <TextView
                    style="@style/TextAppearance.GeoGas.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/details_alternative_fuels"
                    android:textColor="@color/textColorAccent" />

                <TableLayout
                    android:id="@+id/table_alternativos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:stretchColumns="1" />

                <!-- SECCIÓN: INFORMACIÓN ADICIONAL -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/neutral_200" />

                <TextView
                    style="@style/TextAppearance.GeoGas.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/details_additional_info"
                    android:textColor="@color/textColorAccent" />

                <TableLayout
                    android:id="@+id/table_adicional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:stretchColumns="1" />

                <!-- ESPACIO FINAL PARA SCROLL -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</androidx.cardview.widget.CardView>